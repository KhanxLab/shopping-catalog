---
// Diseño A · Tablero (docs/diseno.md): mosaicos planos encajados borde a borde.
import Layout from '../layouts/Layout.astro';
import Mosaico from '../components/Mosaico.astro';
import Pedido from '../components/Pedido.astro';
import PanelVersiones from '../components/PanelVersiones.astro';
import { tienda } from '../data/tienda';
import { destacados, secciones, whatsapp } from '../lib/catalogo';
const [principal, ...secundarios] = destacados;
---
<Layout>
<main class="tablero">
  <header class="cabecera">
    <p class="marca">{tienda.nombre}</p>
    <h1>Códigos para Switch 1 y 2</h1>
    <!-- Consulta general sin elegir nada (#23): enlace, no un segundo botón flotante; mensaje distinto al del pedido. -->
    <a class="consulta" href={whatsapp('Hola, tengo una pregunta sobre el catálogo')} target="_blank" rel="noopener">Preguntar por WhatsApp</a>
  </header>

  {principal && <Mosaico f={principal} tamano="grande" />}
  {secundarios.map((f) => <Mosaico f={f} tamano="medio" />)}

  {secciones.map((s) => (
    <>
      {s.titulo && <h2>{s.titulo}</h2>}
      {s.fichas.map((f) => <Mosaico f={f} />)}
    </>
  ))}
</main>
<Pedido />
<PanelVersiones />
</Layout>

<style>
  .tablero { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-flow: dense; gap: 8px; padding: 10px; }
  .cabecera { grid-column: 1 / -1; border-radius: 8px; padding: 22px 20px 26px; background: var(--rojo); color: #fff; }
  .marca { font-size: 17px; font-weight: 800; }
  h1 { margin-top: 36px; max-width: 12ch; font-size: clamp(38px, 11vw, 88px); font-weight: 800; line-height: .95; letter-spacing: -.035em; }
  .consulta { display: inline-block; margin-top: 18px; font-size: 15px; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  h2 { grid-column: 1 / -1; padding: 26px 4px 2px; font-size: clamp(26px, 6.4vw, 44px); font-weight: 800; letter-spacing: -.03em; line-height: 1; }

  @media (min-width: 760px) {
    /* Hasta 1440px: más ancho, los mosaicos se agrandan de más y las portadas pierden nitidez. */
    .tablero { grid-template-columns: repeat(10, 1fr); padding: 12px; max-width: 1440px; margin: 0 auto; }
    /* Cabecera baja en escritorio: el título en 1 línea deja ver los 3 destacados con su precio sin desplazar. */
    /* El enlace de consulta va a la derecha del nombre: la cabecera no crece y los destacados siguen a la vista. */
    .cabecera { padding: 22px 28px 26px; display: grid; grid-template-columns: 1fr auto; align-items: baseline; column-gap: 16px; }
    .consulta { grid-row: 1; grid-column: 2; margin-top: 0; }
    h1 { grid-column: 1 / -1; margin-top: 18px; max-width: none; }
  }
</style>
